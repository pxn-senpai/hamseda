{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ava",
  "version": "0.2.11",
  "identifier": "dev.hamseda.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix app run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ava",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "ava voice client",
    "longDescription": "ava: a Discord-style voice client for TeamSpeak 3 servers."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEOTE1NTI3MjYwRTRDNEYKUldSUFRBNG1KMVdSSFh6b2F5N3RjK2YwS2FPRkQzRTVVUmhaUUlaMzg3Q2ZIdENDc0FYNXo1SlIK",
      "endpoints": [
        "https://github.com/pxn-senpai/hamseda/releases/latest/download/latest.json"
      ]
    }
  }
}
